---
// Ilustración de una licencia: la clave se completa grupo por grupo y queda activada.
// Es genérica a propósito: no muestra claves reales ni logotipos de terceros. Corre en ciclo mientras está en pantalla y se detiene al salir.
---
<figure class="demo licencia-demo" data-en-vista data-repite>
  <div class="licencia" aria-hidden="true">
    <div class="lic-cab">
      <span class="lic-tit">Licencia</span>
      <span class="lic-estado">
        <span class="est-a">Activando…</span>
        <span class="est-b">Activada</span>
      </span>
    </div>
    <div class="lic-clave">
      <i class="g"></i><i class="g"></i><i class="g"></i><i class="g"></i><i class="g"></i>
    </div>
    <div class="lic-pie">
      <span class="b w2"></span>
      <svg class="check" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="12" cy="12" r="10.5" stroke-width="2" />
        <path d="M7 12.5l3.2 3.2L17 8.8" />
      </svg>
    </div>
  </div>
  <figcaption>Eliges tu licencia y la activas: así de directo.</figcaption>
</figure>

<style>
  .licencia-demo {
    display: grid;
    gap: 1rem;
    justify-items: start;
  }
  .licencia-demo figcaption {
    max-width: 18rem;
    color: var(--gris);
    font-size: var(--t-sm);
  }
  .licencia {
    width: min(21rem, 86vw);
    display: grid;
    gap: 1.4rem;
    padding: 1.4rem;
    border: 3px solid var(--violeta);
    border-radius: 1rem;
    background: #fff;
  }
  .lic-cab {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
    font-size: 0.9375rem;
    font-weight: 700;
  }
  .lic-tit {
    letter-spacing: -0.01em;
  }
  .lic-estado {
    display: grid;
    justify-items: end;
    color: var(--violeta);
  }
  .lic-estado > span {
    grid-area: 1 / 1;
  }
  .est-a {
    opacity: 0;
    visibility: hidden;
  }
  .lic-clave {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 0.4rem;
  }
  .g {
    display: block;
    height: 2.1rem;
    border-radius: 0.35rem;
    background: var(--violeta);
  }
  .lic-pie {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
  }
  .lic-pie .b {
    display: block;
    height: 0.5rem;
    border-radius: 99px;
    background: var(--linea);
  }
  .w2 { width: 55%; }
  .check {
    width: 2.2rem;
    height: 2.2rem;
    color: var(--violeta);
  }

  /* Estado inicial (con JavaScript y movimiento permitido): clave vacía, activando. */
  .listo .licencia { border-color: var(--tinta); }
  .listo .g { background: var(--lila); }
  .listo .check { opacity: 0; transform: scale(0.6); }
  .listo .est-a { opacity: 1; visibility: visible; }
  .listo .est-b { opacity: 0; visibility: hidden; }

  /* Ciclo de 7 s mientras el bloque está a la vista: la clave se llena, se activa y vuelve a empezar. */
  .corre .g:nth-child(1) { animation: g1 7s ease-out infinite; }
  .corre .g:nth-child(2) { animation: g2 7s ease-out infinite; }
  .corre .g:nth-child(3) { animation: g3 7s ease-out infinite; }
  .corre .g:nth-child(4) { animation: g4 7s ease-out infinite; }
  .corre .g:nth-child(5) { animation: g5 7s ease-out infinite; }
  .corre .licencia { animation: borde 7s linear infinite; }
  .corre .check { animation: aparece 7s ease-out infinite; }
  .corre .est-a { animation: sale 7s linear infinite; }
  .corre .est-b { animation: entra 7s linear infinite; }
  @keyframes g1 {
    0%, 4.3% { background: var(--lila); }
    8.6%, 90% { background: var(--violeta); }
    94%, 100% { background: var(--lila); }
  }
  @keyframes g2 {
    0%, 10% { background: var(--lila); }
    14.3%, 90% { background: var(--violeta); }
    94%, 100% { background: var(--lila); }
  }
  @keyframes g3 {
    0%, 15.7% { background: var(--lila); }
    20%, 90% { background: var(--violeta); }
    94%, 100% { background: var(--lila); }
  }
  @keyframes g4 {
    0%, 21.4% { background: var(--lila); }
    25.7%, 90% { background: var(--violeta); }
    94%, 100% { background: var(--lila); }
  }
  @keyframes g5 {
    0%, 27.1% { background: var(--lila); }
    31.4%, 90% { background: var(--violeta); }
    94%, 100% { background: var(--lila); }
  }
  @keyframes borde {
    0%, 35% { border-color: var(--tinta); }
    36%, 90% { border-color: var(--violeta); }
    94%, 100% { border-color: var(--tinta); }
  }
  @keyframes aparece {
    0%, 35% { opacity: 0; transform: scale(0.6); }
    42%, 90% { opacity: 1; transform: scale(1); }
    94%, 100% { opacity: 0; transform: scale(0.6); }
  }
  @keyframes sale {
    0%, 35% { opacity: 1; visibility: visible; }
    36%, 92% { opacity: 0; visibility: hidden; }
    94%, 100% { opacity: 1; visibility: visible; }
  }
  @keyframes entra {
    0%, 35% { opacity: 0; visibility: hidden; }
    36%, 92% { opacity: 1; visibility: visible; }
    94%, 100% { opacity: 0; visibility: hidden; }
  }
</style>
