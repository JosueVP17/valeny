---
import Logo from "./Logo.astro";
import { valeny, urlWhatsApp, MENSAJES } from "../data/index.ts";
const anio = new Date().getFullYear();
---
<footer class="pie">
  <div class="contenedor">
    <div class="pie-in">
      <a class="logo" href="/" aria-label="Valeny, inicio">
        <Logo variante="apilado" class="logo-pie" />
      </a>
      <nav aria-label="Pie de página">
        <a href="/webs">Webs para restaurantes</a>
        <a href={valeny.tienda.url}>{valeny.tienda.nombre}</a>
        <a href="/privacidad">Privacidad</a>
        <a href={urlWhatsApp(MENSAJES.general)} rel="noopener" target="_blank">WhatsApp {valeny.telefono}</a>
        <a href={`mailto:${valeny.correo}`}>{valeny.correo}</a>
        <a href={valeny.instagram} rel="noopener" target="_blank">Instagram @{valeny.instagramUsuario}</a>
      </nav>
      <p>© {anio} Valeny</p>
    </div>
    <p class="pie-nota">
      Valeny crea webs para restaurantes y ofrece licencias de software. Nos encanta el morado, y por eso se nota en todo lo que hacemos.
    </p>
  </div>
</footer>
