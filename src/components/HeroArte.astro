---
// La V de Valeny, grande. Se revela de izquierda a derecha una sola vez al cargar.
import Logo from "./Logo.astro";
---
<div class="arte">
  <Logo variante="simbolo" titulo="" />
</div>

<style>
  .arte {
    width: min(26rem, 100%);
  }
  .arte :global(svg) {
    display: block;
    width: 100%;
    height: auto;
  }
  @media (prefers-reduced-motion: no-preference) {
    .arte :global(svg) {
      animation: revela 1.2s 0.2s cubic-bezier(0.3, 0.7, 0.2, 1) both;
    }
  }
  @keyframes revela {
    from { clip-path: inset(0 100% 0 0); }
    to { clip-path: inset(0 0 0 0); }
  }
</style>
