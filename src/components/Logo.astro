---
// Logotipo de Valeny. La geometría vive en src/data/marca.ts (vectorizada del diseño entregado).
// variante: "horizontal" (la V y la palabra, como en el diseño) o "simbolo" (solo la V).
import { HORIZONTAL, SIMBOLO, COLORES, nuevoId } from "../data/marca.ts";

interface Props {
  class?: string;
  variante?: "horizontal" | "simbolo";
  titulo?: string;
}
const { class: clase, variante = "horizontal", titulo = "Valeny" } = Astro.props;

const dibujo = variante === "simbolo" ? SIMBOLO : HORIZONTAL;
const c = dibujo.caja;
const viewBox = `${c.x0} ${c.y0} ${c.x1 - c.x0} ${c.y1 - c.y0}`;
const id = nuevoId();
const decorativo = titulo === "";
---
<svg
  class={clase}
  viewBox={viewBox}
  role={decorativo ? undefined : "img"}
  aria-label={decorativo ? undefined : titulo}
  aria-hidden={decorativo ? "true" : undefined}
  xmlns="http://www.w3.org/2000/svg"
>
  <defs>
    {Object.entries(dibujo.grad).map(([g, v]) => (
      <linearGradient id={`${id}-${g}`} gradientUnits="userSpaceOnUse" x1={v.x1} y1={v.y1} x2={v.x2} y2={v.y2}>
        <stop offset="0" stop-color={COLORES.claro} />
        <stop offset={v.m} stop-color={COLORES.medio} />
        <stop offset="1" stop-color={COLORES.oscuro} />
      </linearGradient>
    ))}
  </defs>
  {dibujo.piezas.map((p) => <path fill={`url(#${id}-${p.g})`} fill-rule="evenodd" d={p.d} />)}
</svg>
