---
// Marca de "Valeny Webs": una ventana de navegador con la V de Valeny dentro.
interface Props { class?: string; titulo?: string }
const { class: clase, titulo = "Valeny Webs" } = Astro.props;
---
<svg class={clase} viewBox="0 0 48 48" role="img" aria-label={titulo} xmlns="http://www.w3.org/2000/svg">
  <rect x="3" y="6" width="42" height="36" rx="6" fill="none" stroke="var(--violeta)" stroke-width="3.5" />
  <path d="M3 16.5h42" stroke="var(--violeta)" stroke-width="3.5" />
  <circle cx="9.5" cy="11.3" r="1.7" fill="var(--violeta)" />
  <circle cx="15" cy="11.3" r="1.7" fill="var(--violeta)" />
  <circle cx="20.5" cy="11.3" r="1.7" fill="var(--violeta)" />
  <path d="M15.5 24L24 37.5L32.5 24" fill="none" stroke="var(--violeta)" stroke-width="4" stroke-linecap="round" stroke-linejoin="round" />
  <circle cx="32.5" cy="24" r="3.4" fill="var(--violeta)" />
</svg>
