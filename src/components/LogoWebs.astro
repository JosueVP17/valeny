---
// Marca de "Valeny Webs": la V de Valeny con cinco módulos de QR en su hueco.
import { V } from "../data/marca.ts";

interface Props {
  class?: string;
  titulo?: string;
}
const { class: clase, titulo = "Valeny Webs" } = Astro.props;

const k = 82, g = 26, ox = 600, oy = 380;
const celdas = [[0, 0], [2, 0], [1, 1], [0, 2], [2, 2]];
---
<svg class={clase} viewBox="30 140 1070 1045" role="img" aria-label={titulo} xmlns="http://www.w3.org/2000/svg">
  <path fill="var(--violeta)" fill-rule="evenodd" d={`${V.bucle} ${V.hueco}`} />
  <path fill="var(--violeta)" d={V.brazo} />
  {celdas.map(([x, y]) => (
    <rect x={ox + x * (k + g)} y={oy + y * (k + g)} width={k} height={k} rx="17" fill="#9b7bf0" />
  ))}
</svg>
