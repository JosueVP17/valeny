---
import { Image } from "astro:assets";
import Base from "../layouts/Base.astro";
import HeroArte from "../components/HeroArte.astro";
import LogoWebs from "../components/LogoWebs.astro";
import DemoTelefono from "../components/DemoTelefono.astro";
import DemoLicencia from "../components/DemoLicencia.astro";
import logoStore from "../assets/valeny-store.webp";
import { valeny, catalogo, pesos, urlWhatsApp, MENSAJES } from "../data/index.ts";
---
<Base>
  <section class="contenedor portada" aria-labelledby="titulo-portada">
    <div class="portada-texto">
      <h1 id="titulo-portada">Soluciones de tecnología para tu negocio.</h1>
      <p class="lema">Valeny es una empresa de tecnología. Hoy hacemos webs para restaurantes y ofrecemos licencias de software.</p>
      <div class="portada-cta">
        <a class="btn" href={urlWhatsApp(MENSAJES.general)} rel="noopener" target="_blank">Escribir por WhatsApp</a>
        <p class="cta-nota">Para cotizar o resolver dudas. Te respondemos por mensaje.</p>
      </div>
    </div>
    <div class="portada-arte">
      <HeroArte />
    </div>
  </section>

  <section class="quienes seccion" aria-labelledby="titulo-valeny">
    <div class="contenedor quienes-in">
      <h2 id="titulo-valeny">Qué es Valeny</h2>
      <div class="quienes-cuerpo">
        <p class="quienes-grande">Hacemos tecnología para que un negocio trabaje mejor sin tener que volverse experto en software.</p>
        <dl class="principios">
          <div>
            <dt>Simple</dt>
            <dd>Nos escribes por WhatsApp y platicamos de lo que necesitas. Sin formularios ni trámites largos.</dd>
          </div>
          <div>
            <dt>Seguro</dt>
            <dd>Cuidamos lo que construimos. Nuestros sitios no usan cookies ni rastreadores, y los de restaurantes no guardan los datos de sus clientes.</dd>
          </div>
          <div>
            <dt>Tecnológico</dt>
            <dd>Herramientas modernas y soluciones hechas a la medida de cada negocio.</dd>
          </div>
        </dl>
      </div>
    </div>
  </section>

  <section class="contenedor soluciones-intro" aria-labelledby="titulo-soluciones">
    <h2 id="titulo-soluciones">Nuestras soluciones</h2>
    <p class="lema">Hoy son dos.</p>
  </section>

  <article class="solucion" id="webs" aria-labelledby="titulo-webs">
    <div class="contenedor solucion-in">
      <div class="solucion-texto">
        <div class="solucion-marca">
          <LogoWebs class="solucion-logo" />
          <span>Valeny Webs</span>
        </div>
        <h3 id="titulo-webs">Webs para restaurantes</h3>
        <p>Cada restaurante recibe un sitio con su propio diseño y su propio dominio: menú digital, código QR para las mesas, pedido para recoger y solicitud de reservación por WhatsApp.</p>
        <dl class="precios">
          {catalogo.planes.filter((p) => "unico" in p).map((p) => (
            <div>
              <dt>{p.nombre}</dt>
              <dd><strong>{pesos(p.unico)}</strong> <span>pago único + {pesos(p.mensual)} al mes</span></dd>
            </div>
          ))}
        </dl>
        <p class="precios-nota">Precios en pesos mexicanos. El dominio de tu restaurante va incluido.</p>
        <a class="btn" href="/webs">Ver planes completos</a>
      </div>
      <DemoTelefono />
    </div>
  </article>

  <article class="solucion solucion--lila" id="licencias" aria-labelledby="titulo-licencias">
    <div class="contenedor solucion-in solucion-in--invertida">
      <div class="solucion-texto">
        <div class="solucion-marca">
          <Image class="solucion-logo solucion-logo--store" src={logoStore} alt="Logotipo de Valeny Store" width={96} loading="lazy" />
          <span>{valeny.tienda.nombre}</span>
        </div>
        <h3 id="titulo-licencias">Licencias de software</h3>
        <p>En {valeny.tienda.nombre}, nuestra tienda en línea, vendemos licencias de software de Microsoft, antivirus, software de arquitectura y más, para personas y negocios.</p>
        <a class="btn" href={valeny.tienda.url}>Ir a {valeny.tienda.nombre}</a>
        <p class="marca-registrada">Microsoft es una marca registrada de Microsoft Corporation. {valeny.tienda.nombre} no está afiliada a Microsoft.</p>
      </div>
      <DemoLicencia />
    </div>
  </article>

  <section class="contacto seccion" aria-labelledby="titulo-contacto">
    <div class="contenedor contacto-in">
      <h2 id="titulo-contacto">¿Hablamos?</h2>
      <p>Cuéntanos qué necesitas y te respondemos por WhatsApp.</p>
      <a class="btn" href={urlWhatsApp(MENSAJES.general)} rel="noopener" target="_blank">Escribir por WhatsApp</a>
      <a href={`mailto:${valeny.correo}`}>{valeny.correo}</a>
    </div>
  </section>
</Base>

<script>
  import "../scripts/enVista.ts";
</script>
